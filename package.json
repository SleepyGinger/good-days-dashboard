{
  "name": "good-days-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "typecheck": "tsc --noEmit --incremental false && tsc --noEmit -p vercel-api/tsconfig.json",
    "lint": "eslint src tests scripts vercel-api --no-cache",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "prebuild": "node scripts/check-build-env.mjs",
    "build": "next build",
    "prebuild:ios": "node scripts/check-build-env.mjs",
    "build:ios": "CAPACITOR_BUILD=1 next build",
    "cap:sync": "cap sync ios",
    "deploy": "npm run check && npm run build && git push",
    "deploy:ios": "npm run check && npm run build:ios && cap sync ios && xcodebuild archive -project ios/App/App.xcodeproj -scheme 'Good Days' -archivePath ios/build/GoodDays.xcarchive -destination 'generic/platform=iOS' -allowProvisioningUpdates && xcodebuild -exportArchive -archivePath ios/build/GoodDays.xcarchive -exportOptionsPlist ios/ExportOptions.plist -allowProvisioningUpdates",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.2",
    "@radix-ui/react-dialog": "^1.1.10",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^11.6.0",
    "framer-motion": "^12.7.4",
    "lightningcss": "^1.30.2",
    "lucide-react": "^0.501.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-day-picker": "^9.6.7",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.2.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.2.5",
    "typescript": "^5",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/ios": "^8.0.2",
    "tsx": "4.23.15",
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "brace-expansion@^1.0.0": "1.1.21",
    "postcss": "^8.5.32"
  }
}
